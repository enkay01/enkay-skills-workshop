{
  "fast-tools-optimizer": {
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "~/.local/bin/fast-tools hook-pre",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "replace_file_content|write_to_file",
        "hooks": [
          {
            "type": "command",
            "command": "~/.local/bin/fast-tools hook-post",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
